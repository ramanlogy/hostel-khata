{
  "name": "hostel-khata",
  "productName": "Hostel Khata",
  "version": "1.1.0",
  "description": "Hostel fees, students, rooms and expenses",
  "author": "Hostel Khata",
  "private": true,
  "main": "main.js",
  "scripts": {
    "copy-web": "node scripts/copy-web.js",
    "start": "npm run copy-web && electron .",
    "dist:win": "npm run copy-web && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "np.hostelkhata.app",
    "productName": "Hostel Khata",
    "files": ["main.js", "preload.js", "web/**", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hostel Khata",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Hostel-Khata-Setup-${version}.exe"
    }
  }
}
